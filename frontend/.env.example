# URL of the Java API (server-side only; the browser talks to this app, which relays /api/*)
BACKEND_URL=http://localhost:8080
# Same value as FRONTEND_SHARED_SECRET on the backend. Leave empty in local development.
FRONTEND_SHARED_SECRET=
# Product name shown in the UI (the brand is not defined yet)
NEXT_PUBLIC_APP_NAME=Configurador de PC
